{
  "name": "two-key",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts",
    "spikes",
    "eval"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n web,gw,mcp,run -c cyan,green,magenta,yellow \"npm run dev -w @twokey/web\" \"npm run dev -w @twokey/gateway\" \"npm run dev -w @twokey/mcp\" \"npm run dev -w @twokey/agent-runner\"",
    "lint": "biome check .",
    "typecheck": "tsc -b && npm run typecheck -w @twokey/web",
    "test": "vitest run",
    "check:secrets": "tsx scripts/check-secret-isolation.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:secrets",
    "format": "biome format --write .",
    "spike:vault": "dotenv -e .env.gateway -- tsx spikes/vault-spike.ts",
    "spike:honor": "dotenv -e .env.gateway -- tsx spikes/honor-capture.ts",
    "spike:verify": "dotenv -e .env.gateway -- tsx spikes/verify-spike.ts",
    "paypal:webhook": "dotenv -e .env.gateway -- tsx scripts/register-webhook.ts",
    "db:migrate": "dotenv -e .env.gateway -- npm run db:migrate -w @twokey/db",
    "db:seed": "dotenv -e .env.gateway -- npm run db:seed -w @twokey/db",
    "db:seed-users": "dotenv -e .env.gateway -- tsx scripts/seed-users.ts",
    "e2e:purchase": "dotenv -e .env.gateway -- tsx scripts/e2e-purchase.ts",
    "keys:gen": "tsx scripts/gen-keys.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "concurrently": "^9",
    "dotenv-cli": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "yaml": "^2"
  }
}
