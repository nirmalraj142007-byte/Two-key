{
  "name": "two-key",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts",
    "spikes",
    "eval"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n web,gw,mcp,run -c cyan,green,magenta,yellow \"npm run dev -w @twokey/web\" \"npm run dev -w @twokey/gateway\" \"npm run dev -w @twokey/mcp\" \"npm run dev -w @twokey/agent-runner\"",
    "lint": "biome check .",
    "typecheck": "tsc -b && npm run typecheck -w @twokey/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "check:secrets": "tsx scripts/check-secret-isolation.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:secrets",
    "format": "biome format --write .",
    "spike:vault": "dotenv -e .env.gateway -- tsx spikes/vault-spike.ts",
    "vault:hijack": "dotenv -e .env.gateway -- tsx spikes/hijack-vault.ts",
    "spike:honor": "dotenv -e .env.gateway -- tsx spikes/honor-capture.ts",
    "spike:verify": "dotenv -e .env.gateway -- tsx spikes/verify-spike.ts",
    "spike:expiry": "dotenv -e .env.gateway -- tsx scripts/expiry-mock-check.ts",
    "paypal:webhook": "dotenv -e .env.gateway -- tsx scripts/register-webhook.ts",
    "db:migrate": "dotenv -e .env.gateway -- npm run db:migrate -w @twokey/db",
    "db:seed": "dotenv -e .env.gateway -- npm run db:seed -w @twokey/db",
    "db:seed-users": "dotenv -e .env.gateway -- tsx scripts/seed-users.ts",
    "demo:hook": "dotenv -e .env.gateway -- tsx scripts/seed-demo-hook.ts",
    "e2e:purchase": "dotenv -e .env.gateway -- tsx scripts/e2e-purchase.ts",
    "ci:sandbox-env": "tsx scripts/ci-sandbox-env.ts",
    "e2e:login": "playwright test -c apps/web/playwright.config.ts",
    "e2e:tenancy": "tsx scripts/live-tenancy.ts",
    "compiler:smoke": "dotenv -e .env.web -- tsx scripts/compiler-smoke.ts",
    "keys:gen": "tsx scripts/gen-keys.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "mcp:pack-smoke": "tsx scripts/mcp-pack-smoke.ts",
    "mcp:release": "tsx scripts/mcp-release.ts",
    "channel3:smoke": "dotenv -e .env.gateway -- tsx scripts/channel3-smoke.ts",
    "agent:once": "dotenv -e .env.agent-runner -- tsx apps/agent-runner/src/worker.ts --once",
    "eval:stack": "concurrently -n gw,mcp,run -c green,magenta,yellow \"dotenv -v PORT=4010 -v EVAL_ENABLED=true -e .env.gateway -- npm run start -w @twokey/gateway\" \"dotenv -v PORT=4110 -v GATEWAY_URL=http://localhost:4010 -e .env.mcp -- npm run start -w @twokey/mcp\" \"dotenv -v PORT=4210 -v MCP_URL=http://localhost:4110/mcp -e .env.agent-runner -- npm run start -w @twokey/agent-runner\"",
    "eval": "dotenv -v GATEWAY_URL=http://localhost:4010 -v MCP_URL=http://localhost:4110/mcp -e .env.eval -- tsx eval/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9",
    "dotenv-cli": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "yaml": "^2"
  }
}
