# NOTE: in dev each service loads its own file via dotenv-cli ("dotenv -e ../../.env.<service> --"):
#   for s in gateway web mcp agent-runner; do cp .env.example .env.$s; done
# Fill in only the variables that service needs; secrets must stay on their owners.
# Empty values count as unset. .env.* files are git-ignored.

# Two-Key environment variables, grouped by service. Copy to .env.<service> and fill in.
# A secret may only be set on its owning service (see SECRET_OWNERS in packages/core/src/env.ts).

# ---- common (all services) ----
# development | test | production
NODE_ENV=
# pino log level (default info)
LOG_LEVEL=
# Postgres connection string (not needed by mcp)
DATABASE_URL=

# ---- gateway ----
# PayPal environment; only 'sandbox' is supported
PAYPAL_ENV=
# PayPal REST app client ID
PAYPAL_CLIENT_ID=
# PayPal REST app client secret (gateway only)
PAYPAL_CLIENT_SECRET=
# PayPal webhook ID (optional until phase 4)
PAYPAL_WEBHOOK_ID=
# Base64 HMAC key for signing rule cards, at least 32 bytes decoded (gateway only)
RULE_HMAC_KEY=
# Identifier of the active rule HMAC key
RULE_HMAC_KEY_ID=
# Ed25519 public key (PEM) used to verify human assertions
HUMAN_ASSERTION_PUBLIC_KEY=
# Pepper for hashing agent tokens (gateway only)
AGENT_TOKEN_PEPPER=
# Hold timeout in minutes for demo sessions (optional; overrides the rule card)
DEMO_HOLD_MINUTES=15
# Channel3 search API key (optional; gateway and eval only)
CHANNEL3_API_KEY=
# Web push VAPID public key
VAPID_PUBLIC_KEY=
# Web push VAPID private key (gateway only)
VAPID_PRIVATE_KEY=
# Web push VAPID subject, mailto: or https: URL (optional until phase 18)
VAPID_SUBJECT=
# Origin of the web app, used for CORS
WEB_ORIGIN=
# Public base URL of the gateway
PUBLIC_BASE_URL=
# Gateway port (default 4000)
PORT=
# Optional JSON {"<merchant slug>":{"clientId":"...","clientSecret":"..."}} (gateway only)
MERCHANT_API_CREDENTIALS=
# Mounts POST /internal/eval/sessions (local only: never in render.yaml or on Render; default false)
EVAL_ENABLED=
# Shared eval admin token, 32 random bytes base64 (gateway and eval only)
EVAL_ADMIN_TOKEN=
# Password for the seeded demo users (read by npm run db:seed-users; local only, never printed)
DEMO_PASSWORD=

# ---- web ----
# Auth.js secret (web only)
AUTH_SECRET=
# Ed25519 private key (PEM) that mints human assertions (web only)
HUMAN_ASSERTION_PRIVATE_KEY=
# Gateway base URL (also used by mcp, agent-runner is via MCP_URL, eval)
GATEWAY_URL=
# Anthropic API key (web only when COMPILER_PROVIDER=anthropic; agent-runner, eval)
ANTHROPIC_API_KEY=
# Rule compiler provider: openai-compatible (default) | anthropic
COMPILER_PROVIDER=
# OpenAI-compatible base URL (default https://api.groq.com/openai/v1)
COMPILER_BASE_URL=
# Compiler API key (web and eval only)
COMPILER_API_KEY=
# Compiler model (default openai/gpt-oss-120b on Groq)
COMPILER_MODEL=
# Daily live LLM spend cap in USD (default 2)
DAILY_BUDGET_USD_LIVE=
# AG Grid Enterprise licence key (optional)
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
# VAPID public key exposed to the browser (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Salt for hashing visitor IPs
IP_HASH_SALT=

# ---- mcp ----
# Agent token for stdio mode (optional)
TWOKEY_AGENT_TOKEN=
# MCP server port (default 4100)

# ---- agent-runner ----
# API key for the OpenAI-compatible agent endpoint, Groq by default (agent-runner and eval only)
AGENT_LLM_API_KEY=
# Base URL of that endpoint (default https://api.groq.com/openai/v1)
AGENT_LLM_BASE_URL=
# Model for live, demo and hijack sessions (default openai/gpt-oss-20b until Nov 7, then openai/gpt-oss-120b); claude-* uses ANTHROPIC_API_KEY
AGENT_MODEL=
# Provider for those sessions: nim (default until Nov 7; uses EVAL_LLM_*) | groq (AGENT_LLM_*)
AGENT_PROVIDER=
# Daily LLM budget in USD for evaluation runs (default 100)
DAILY_BUDGET_USD_EVAL=
# URL of the MCP server the runner connects to (also used by eval)
MCP_URL=
# Daily LLM budget in USD for live sessions (default 5)
DAILY_BUDGET_USD_LIVE=
# Daily LLM budget in USD for hijack sessions (default 10)
DAILY_BUDGET_USD_HIJACK=
# Agent-runner port (default 4200)

# ---- eval ----
# Uses AGENT_LLM_API_KEY, AGENT_LLM_BASE_URL, CHANNEL3_API_KEY, GATEWAY_URL and MCP_URL from above
# OpenAI-compatible endpoint for eval sessions (default https://integrate.api.nvidia.com/v1, NVIDIA NIM)
EVAL_LLM_BASE_URL=
# NIM API key for the NIM eval models and the grader (agent-runner and eval only)
EVAL_LLM_API_KEY=
# Comma list of evaluation models, large first (default openai/gpt-oss-120b,openai/gpt-oss-20b,nvidia/nemotron-3.5-bolt-e4b; gpt-oss-120b uses AGENT_LLM_* on Groq)
EVAL_MODELS=
# Model the Oct 29 checkpoint looks at (default nvidia/nemotron-3.5-bolt-e4b)
EVAL_WEAK_MODEL=
# Daily budget cap in USD for eval runs and grading (default 25)
EVAL_BUDGET_USD=
