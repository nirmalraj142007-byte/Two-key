{
  "name": "@twokey/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "twokey-mcp": "./dist/twokey-mcp.js"
  },
  "files": [
    "dist/twokey-mcp.js"
  ],
  "scripts": {
    "dev": "dotenv -e ../../.env.mcp -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node20 --external:@modelcontextprotocol/sdk --external:zod --alias:@twokey/core=../../packages/core/src/errors.ts --outfile=dist/twokey-mcp.js",
    "prepack": "npm run bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@twokey/core": "*",
    "esbuild": "^0.28.2"
  }
}
